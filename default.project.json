{
  "name": "EverLeaf Roblox",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "EverLeafRemotes": {
        "$className": "Folder",
        "ProfileReady": {
          "$className": "RemoteEvent"
        },
        "ProfileChanged": {
          "$className": "RemoteEvent"
        },
        "AllocateStat": {
          "$className": "RemoteFunction"
        },
        "RequestProfile": {
          "$className": "RemoteFunction"
        },
        "BasicAttack": {
          "$className": "RemoteFunction"
        },
        "GameAction": {
          "$className": "RemoteFunction"
        },
        "RequestCatalog": {
          "$className": "RemoteFunction"
        },
        "PartyEvent": {
          "$className": "RemoteEvent"
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true
      }
    }
  }
}
