local StateMachine = require("../src/shared/StateMachine")
local machine = StateMachine.new("Idle", { Idle = { "Active" }, Active = { "Done" }, Done = {} })
assert(machine:GetState() == "Idle", "initial state")
assert(machine:CanTransition("Active"), "Idle -> Active must be allowed")
local ok = machine:Transition("Active")
assert(ok and machine:GetState() == "Active", "transition to Active")
local bad = machine:Transition("Idle")
assert(not bad and machine:GetState() == "Active", "invalid transition must not mutate state")
assert(machine:Transition("Done"), "Active -> Done")
print("state machine tests passed")
