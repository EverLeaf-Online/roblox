local PartyRules = require("../src/shared/Logic/PartyRules")

local ok, reason = PartyRules.CanAccept(false, true, false, true, false)
assert(ok and reason == nil, "valid invitation can be accepted")
ok, reason = PartyRules.CanAccept(true, true, false, true, false)
assert(not ok and reason == "already_in_party", "party member cannot accept another invite")
ok, reason = PartyRules.CanAccept(false, false, false, true, false)
assert(not ok and reason == "no_invitation", "accept requires an invitation")
ok, reason = PartyRules.CanAccept(false, true, true, true, false)
assert(not ok and reason == "no_invitation", "expired invite rejected")
ok, reason = PartyRules.CanAccept(false, true, false, false, false)
assert(not ok and reason == "party_unavailable", "missing party rejected")
ok, reason = PartyRules.CanAccept(false, true, false, true, true)
assert(not ok and reason == "party_full", "full party rejects acceptance")

ok, reason = PartyRules.CanInvite(true, 1, 6, true, false, false)
assert(ok and reason == nil, "leader can invite valid target")
ok, reason = PartyRules.CanInvite(false, 1, 6, true, false, false)
assert(not ok and reason == "not_party_leader", "non-leader cannot invite")
ok, reason = PartyRules.CanInvite(true, 6, 6, true, false, false)
assert(not ok and reason == "party_full", "full party cannot invite")
ok, reason = PartyRules.CanInvite(true, 2, 6, true, true, false)
assert(not ok and reason == "invalid_target", "self invite rejected")
ok, reason = PartyRules.CanInvite(true, 2, 6, true, false, true)
assert(not ok and reason == "target_in_party", "target already in party rejected")

print("party rules tests passed")
